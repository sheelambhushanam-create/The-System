<button class="w-full h-[52px] bg-primary text-on-primary rounded-full font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 shadow-md active:scale-[0.98] transition-transform" id="primary-action-btn" onclick="logMetricsCelebration()">
<span class="material-symbols-outlined text-[22px]">check_circle</span>
<span id="action-btn-text">Complete Set &amp; Sync Biometrics</span>
</button>
</div>
</div>
<script>
  let activeTab = 'workout';
  let audioCoachEnabled = true;
  let restTimerActive = false;
  let restSeconds = 45;
  let restInterval;

  function switchFocusMode(mode) {
    activeTab = mode;
    const tabWorkout = document.getElementById('tab-workout');
    const tabRecipe = document.getElementById('tab-recipe');
    const secWorkout = document.getElementById('section-workout');
    const secRecipe = document.getElementById('section-recipe');
    const actionText = document.getElementById('action-btn-text');

    if (mode === 'workout') {
      tabWorkout.className = "flex-1 py-2 rounded-full font-label-md text-label-md flex items-center justify-center gap-1.5 transition-all duration-200 bg-surface-container-lowest text-primary shadow-sm font-bold";
      tabRecipe.className = "flex-1 py-2 rounded-full font-label-md text-label-md flex items-center justify-center gap-1.5 transition-all duration-200 text-on-surface-variant hover:text-on-surface";
      secWorkout.classList.remove('hidden');
      secRecipe.classList.remove('opacity-60');
      actionText.textContent = "Complete Set & Sync Biometrics";
    } else {
      tabRecipe.className = "flex-1 py-2 rounded-full font-label-md text-label-md flex items-center justify-center gap-1.5 transition-all duration-200 bg-surface-container-lowest text-primary shadow-sm font-bold";
      tabWorkout.className = "flex-1 py-2 rounded-full font-label-md text-label-md flex items-center justify-center gap-1.5 transition-all duration-200 text-on-surface-variant hover:text-on-surface";
      actionText.textContent = "Log Meal & Check Nutrition Ring";
      secRecipe.scrollIntoView({ behavior: 'smooth' });
    }
  }

  function toggleAudioCoach() {
    audioCoachEnabled = !audioCoachEnabled;
    const icon = document.getElementById('coach-icon');
    const text = document.getElementById('coach-text');
    if (audioCoachEnabled) {
      icon.textContent = 'volume_up';
      text.textContent = 'Voice On';
    } else {
      icon.textContent = 'volume_off';
      text.textContent = 'Muted';
    }
  }

  function startRestCountdown() {
    if (restTimerActive) return;
    restTimerActive = true;
    restSeconds = 45;
    const label = document.getElementById('rest-label');
    const btn = document.getElementById('rest-btn');
    btn.classList.add('bg-primary/10', 'text-primary');

    restInterval = setInterval(() => {
      restSeconds--;
      label.textContent = `Resting: ${restSeconds}s remaining`;
      if (restSeconds <= 0) {
        clearInterval(restInterval);
        restTimerActive = false;
        label.textContent = "Rest Complete • Start Set 3";
        btn.classList.remove('bg-primary/10', 'text-primary');
      }
    }, 1000);
  }

  function logMetricsCelebration() {
    const btn = document.getElementById('primary-action-btn');
    const currentText = document.getElementById('action-btn-text');
    const originalText = currentText.textContent;
    btn.classList.add('bg-secondary-container', 'text-on-secondary-container');
    currentText.textContent = "✓ Biometrics Streamed & Saved!";

    setTimeout(() => {
      btn.classList.remove('bg-secondary-container', 'text-on-secondary-container');
      currentText.textContent = originalText;
    }, 2400);
  }
</script></main><div class="fixed bottom-0 w-full z-50 pointer-events-none pb-safe px-margin-mobile mb-3"><nav class="pointer-events-auto max-w-md mx-auto h-16 bg-surface-container-lowest/90 backdrop-blur-xl rounded-full shadow-[0_10px_30px_-4px_rgba(15,23,42,0.08)] flex items-center justify-around px-space-sm" data-active-classes="text-primary font-bold"><a class="flex flex-col items-center justify-center min-w-[56px] h-11 text-on-surface-variant hover:text-on-surface transition-colors" data-path="today" href="#"><span class="material-symbols-outlined text-[22px]">wb_sunny</span><span class="font-label-sm text-label-sm tracking-tight">Today</span></a><a class="flex flex-col items-center justify-center min-w-[56px] h-11 text-on-surface-variant hover:text-on-surface transition-colors" data-path="plan-and-recipes" href="#"><span class="material-symbols-outlined text-[22px]">explore</span><span class="font-label-sm text-label-sm tracking-tight">Plan &amp; Food</span></a><a class="flex flex-col items-center justify-center min-w-[56px] h-11 text-on-surface-variant hover:text-on-surface transition-colors" data-path="challenges" href="#"><span class="material-symbols-outlined text-[22px]">emoji_events</span><span class="font-label-sm text-label-sm tracking-tight">Challenges</span></a><a class="flex flex-col items-center justify-center min-w-[56px] h-11 text-on-surface-variant hover:text-on-surface transition-colors" data-path="profile" href="#"><span class="material-symbols-outlined text-[22px]">tune</span><span class="font-label-sm text-label-sm tracking-tight">Profile</span></a></nav></div></body></html>